NATIVE_PAGE_TITLE (TB 16 "UNITED STATES - LIBERTY ISSUE" 5)
NATIVE_PAGE_HEADER (HN 9 C "INNER BORDERS - STYLE / STATE / CANCELLATION" 0 0)
NATIVE_PAGE_MARGIN_TEXT (HN 9 "INNER BORDER - REFERENCE" L CENTRE UP 2 darkblue)
NATIVE_PAGE_FOOTER_NUMBER (HN 9 C 1 "Page " " of $PAGES$" 0 0 darkblue)
NATIVE_ROW_ALIGNMENT (center)
NATIVE_STAMP_FRAME (0.1 black 6)
NATIVE_STAMP_TEXT_POLICY (wrap_to_frame percent 100 0 0 1.5)
NATIVE_STAMP_IMAGE_POLICY (millimetres 0 0 false preserve colour show)
