NATIVE_ROW_BREAK ()
# Explicit native equivalent of NO_FRAME: suppress both outlines.
NATIVE_STAMP_OUTLINE (hide)
NATIVE_STAMP_INNER_BORDER (0 0 SOLID darkblue)
STAMP_IMAGE ("../stamp-pagination-v1/us-152.png" 26 29 0.052 "HN" 8 "DB 152 / SG 1137b\n26 x 29 mm\nNO_FRAME boundary probe")
# Outer BLANK retains inner frame, without changing physical image bounds.
NATIVE_STAMP_INNER_BORDER (2 0.2 SOLID darkblue)
STAMP_IMAGE ("../stamp-pagination-v1/us-151.png" 26 29 0.0534979424 "HN" 8 "DB 151 / SG 1137a\n26 x 29 mm\nOuter BLANK boundary probe")
