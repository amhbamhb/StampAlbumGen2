NATIVE_ROW_BREAK ()
NATIVE_STAMP_INNER_BORDER (2 0.2 DOTTED darkred)
STAMP_IMAGE ("../stamp-pagination-v1/us-152.png" 26 29 0.052 "HN" 8 "DB 152 / SG 1137b\n26 x 29 mm\nDarkred dotted inner frame")
NATIVE_STAMP_INNER_BORDER (2 0.2 DASHED darkred)
STAMP_IMAGE ("../stamp-pagination-v1/us-156.png" 52 29 0.0506822612 "HN" 8 "DB 156 / SG 1148a\n52 x 29 mm\nDarkred dashed inner frame")
NATIVE_ROW_BREAK ()
NATIVE_STAMP_INNER_BORDER (2 0.2 DOT_DASH darkgreen)
STAMP_IMAGE ("../stamp-pagination-v1/us-151.png" 26 29 0.0534979424 "HN" 8 "DB 151 / SG 1137a\n26 x 29 mm\nDarkgreen dot-dash inner")
NATIVE_STAMP_INNER_BORDER (2 0.2 BLANK darkgreen)
STAMP_IMAGE ("../stamp-pagination-v1/us-152.png" 26 29 0.052 "HN" 8 "DB 152 / SG 1137b\n26 x 29 mm\nInner style BLANK")
NATIVE_ROW_BREAK ()
NATIVE_STAMP_INNER_BORDER (2 0.2 SOLID darkblue)
NATIVE_STAMP_SETTINGS_SAVE ()
NATIVE_STAMP_INNER_BORDER (1 0.35 SOLID darkred)
STAMP_IMAGE ("../stamp-pagination-v1/us-156.png" 52 29 0.0506822612 "HN" 8 "DB 156 / SG 1148a\n52 x 29 mm\nTemporary inner settings")
NATIVE_STAMP_SETTINGS_RESTORE ()
