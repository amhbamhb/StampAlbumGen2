# AlbumEasy 4.5.0 reference only. All-in-one comprehensive showcase.
ALBUM_PAGES_SIZE (215.9 279.4)
ALBUM_PAGES_MARGINS (15 15 15 15)
ALBUM_PAGES_SPACING (4 14)
ALBUM_PAGES_BORDER (0.2 0 0 0)
ALBUM_PAGES_TITLE (TB 16 "UNITED STATES - PAGE BREAK SHOWCASE" 5)
ALBUM_PAGES_FOOTER_NUMBER (HN 9 C 1 "Page " " of $PAGES$")
STAMP_BOXES_SIZE_ADJUST (0)
STAMP_BORDER_STYLE (SOLID)
ALBUM_STAMP_IMG_NEW_SETTING (3 3 false)
ALBUM_STAMP_IMG_ASPECT_RATIO (true)

# Group template definition for the showcase
PAGE_START_GROUP_BEGIN
PAGE_TEXT_CENTRE (TB 11 $$1 5)
PAGE_TEXT_CENTRE (HN 9 $$2 5)
PAGE_TEXT_CENTRE (HN 8 $$3 5)
PAGE_START_GROUP_END

# VARIATION 1: BASIC PAGE 1
PAGE_START ("EXPLICIT PAGE START - PAGE ONE" "Variation 1: Basic Explicit Page Start" "The next pair starts on a new page despite unused space")
ROW_START_ES (HN 8 0.1)
STAMP_ADD_IMG (58 35 "../stamp-pagination-v1/us-150.png" "" "DB 150 / SG 1125a\n52 x 29 mm physical size\nFirst-page wide design" "")
