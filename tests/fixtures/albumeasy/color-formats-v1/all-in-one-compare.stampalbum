STAMPALBUM 1
# Comprehensive Native PDF Color Format Comparison Showcase (All 6 Variations)
ALBUM_PAGES_SIZE (215.9 279.4)
ALBUM_PAGES_MARGINS (15.0 15.0 15.0 15.0)
ALBUM_PAGES_SPACING (4.0 10.0)
ALBUM_PAGES_BORDER (1.5 0.5 0.0 1.5)
COLOR_ALBUM_BORDER (#1E4A7A)
NATIVE_PAGE_TITLE (TB 15 "NATIVE PDF COLOR SUPPORT - ALL-IN-ONE SHOWCASE" 8 #1E4A7A)
NATIVE_ROW_ALIGNMENT (left)
NATIVE_STAMP_FRAME (0.6 #2B5B84 2)
NATIVE_STAMP_TEXT_POLICY (expand_footprint percent 140 2.0 1.0 2.5)

# ==============================================================================
# PAGE 1: 6-Digit Hexadecimal Colors (#RRGGBB)
# Border: #1E4A7A (Navy Blue) | Frame: #2B5B84 (Slate Blue)
# ==============================================================================
STAMP_IMAGE ("../spacing-v1/images/san-marino.jpg" 35.0 26.0 0.175 "HN" 8 "PAGE 1: 6-DIGIT HEX (#RRGGBB)\nBorder: #1E4A7A Navy Blue\nSan Marino Specimen")
STAMP_IMAGE ("../spacing-v1/images/new-zealand.jpg" 36.0 22.0 0.162 "HN" 8 "PAGE 1: 6-DIGIT HEX (#RRGGBB)\nMount Frame: #2B5B84 Slate\nNew Zealand Specimen")
NATIVE_ROW_BREAK ()
STAMP_IMAGE ("../spacing-v1/images/malta.jpg" 22.0 34.0 0.155 "HN" 8 "PAGE 1: Case-Insensitive Hex\nAccent: #8B0000 Dark Red\nMalta Specimen")
STAMP_IMAGE ("../spacing-v1/images/sweden.jpg" 23.0 27.0 0.164 "HN" 8 "PAGE 1: Exact 24-Bit RGB\nAccent: #006400 Dark Green\nSweden Specimen")

# ==============================================================================
# PAGE 2: 3-Digit Shorthand Hex Colors (#RGB)
# Border: #F80 (Bright Orange, expands to #FF8800)
# ==============================================================================
NATIVE_PAGE_BREAK ()
COLOR_ALBUM_BORDER (#F80)
STAMP_IMAGE ("../spacing-v1/images/san-marino.jpg" 35.0 26.0 0.175 "HN" 8 "PAGE 2: 3-DIGIT HEX (#RGB)\nBorder: #F80 Bright Orange\nSan Marino (expands to #FF8800)")
STAMP_IMAGE ("../spacing-v1/images/new-zealand.jpg" 36.0 22.0 0.162 "HN" 8 "PAGE 2: 3-DIGIT HEX (#RGB)\nAccent: #036 Deep Navy\nNew Zealand (expands to #003366)")
NATIVE_ROW_BREAK ()
STAMP_IMAGE ("../spacing-v1/images/malta.jpg" 22.0 34.0 0.155 "HN" 8 "PAGE 2: Duplicated Nibbles\nAccent: #C00 Bright Red\nMalta (expands to #CC0000)")
STAMP_IMAGE ("../spacing-v1/images/sweden.jpg" 23.0 27.0 0.164 "HN" 8 "PAGE 2: Duplicated Nibbles\nAccent: #080 Green\nSweden (expands to #008800)")

# ==============================================================================
# PAGE 3: Bare Hexadecimal Colors (Without Hash Prefix)
# Border: 2E8B57 (Sea Green)
# ==============================================================================
NATIVE_PAGE_BREAK ()
COLOR_ALBUM_BORDER (2E8B57)
STAMP_IMAGE ("../spacing-v1/images/san-marino.jpg" 35.0 26.0 0.175 "HN" 8 "PAGE 3: BARE HEX (NO # PREFIX)\nBorder: 2E8B57 Sea Green\nSan Marino Specimen")
STAMP_IMAGE ("../spacing-v1/images/new-zealand.jpg" 36.0 22.0 0.162 "HN" 8 "PAGE 3: BARE HEX (NO # PREFIX)\nAccent: 1E4A7A Prussian Blue\nNew Zealand Specimen")
NATIVE_ROW_BREAK ()
STAMP_IMAGE ("../spacing-v1/images/malta.jpg" 22.0 34.0 0.155 "HN" 8 "PAGE 3: Direct Bare Input\nAccent: 800020 Burgundy\nMalta Specimen")
STAMP_IMAGE ("../spacing-v1/images/sweden.jpg" 23.0 27.0 0.164 "HN" 8 "PAGE 3: Direct Bare Input\nAccent: 4B0082 Indigo\nSweden Specimen")

# ==============================================================================
# PAGE 4: Functional RGB Integer Syntax: rgb(R, G, B)
# Border: rgb(178, 34, 34) (Firebrick Red)
# ==============================================================================
NATIVE_PAGE_BREAK ()
COLOR_ALBUM_BORDER ("rgb(178, 34, 34)")
STAMP_IMAGE ("../spacing-v1/images/san-marino.jpg" 35.0 26.0 0.175 "HN" 8 "PAGE 4: INTEGER RGB: rgb(r,g,b)\nBorder: rgb(178, 34, 34) Firebrick\nSan Marino Specimen")
STAMP_IMAGE ("../spacing-v1/images/new-zealand.jpg" 36.0 22.0 0.162 "HN" 8 "PAGE 4: INTEGER RGB: rgb(r,g,b)\nAccent: rgb(30, 74, 122) Cobalt Blue\nNew Zealand Specimen")
NATIVE_ROW_BREAK ()
STAMP_IMAGE ("../spacing-v1/images/malta.jpg" 22.0 34.0 0.155 "HN" 8 "PAGE 4: Calibrated 0 to 255\nAccent: rgb(34, 139, 34) Forest Green\nMalta Specimen")
STAMP_IMAGE ("../spacing-v1/images/sweden.jpg" 23.0 27.0 0.164 "HN" 8 "PAGE 4: Calibrated 0 to 255\nAccent: rgb(218, 165, 32) Goldenrod\nSweden Specimen")

# ==============================================================================
# PAGE 5: Functional RGB Percentage Syntax: rgb(R%, G%, B%)
# Border: rgb(50%, 0%, 50%) (Deep Purple)
# ==============================================================================
NATIVE_PAGE_BREAK ()
COLOR_ALBUM_BORDER ("rgb(50%, 0%, 50%)")
STAMP_IMAGE ("../spacing-v1/images/san-marino.jpg" 35.0 26.0 0.175 "HN" 8 "PAGE 5: PERCENT RGB: rgb(r%,g%,b%)\nBorder: rgb(50%, 0%, 50%) Purple\nSan Marino Specimen")
STAMP_IMAGE ("../spacing-v1/images/new-zealand.jpg" 36.0 22.0 0.162 "HN" 8 "PAGE 5: PERCENT RGB: rgb(r%,g%,b%)\nAccent: rgb(12%, 29%, 48%) Navy\nNew Zealand Specimen")
NATIVE_ROW_BREAK ()
STAMP_IMAGE ("../spacing-v1/images/malta.jpg" 22.0 34.0 0.155 "HN" 8 "PAGE 5: Proportional Mixing 0-100%\nAccent: rgb(80%, 15%, 25%) Wine\nMalta Specimen")
STAMP_IMAGE ("../spacing-v1/images/sweden.jpg" 23.0 27.0 0.164 "HN" 8 "PAGE 5: Proportional Mixing 0-100%\nAccent: rgb(85%, 65%, 13%) Amber\nSweden Specimen")

# ==============================================================================
# PAGE 6: SVG and CSS Standard Named Colors
# Border: forestgreen (Deep Forest Green)
# ==============================================================================
NATIVE_PAGE_BREAK ()
COLOR_ALBUM_BORDER (forestgreen)
STAMP_IMAGE ("../spacing-v1/images/san-marino.jpg" 35.0 26.0 0.175 "HN" 8 "PAGE 6: SVG/CSS NAMED COLORS\nBorder: forestgreen Keyword\nSan Marino Specimen")
STAMP_IMAGE ("../spacing-v1/images/new-zealand.jpg" 36.0 22.0 0.162 "HN" 8 "PAGE 6: SVG/CSS NAMED COLORS\nAccent: midnightblue Keyword\nNew Zealand Specimen")
