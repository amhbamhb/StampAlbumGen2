STAMP_IMAGE ("../spacing-v1/images/malta.jpg" 22.0 34.0 0.155 "HN" 8 "PAGE 6: Standard Color Palette\nAccent: crimson Keyword\nMalta Specimen")
STAMP_IMAGE ("../spacing-v1/images/sweden.jpg" 23.0 27.0 0.164 "HN" 8 "PAGE 6: Standard Color Palette\nAccent: darkmagenta Keyword\nSweden Specimen")
