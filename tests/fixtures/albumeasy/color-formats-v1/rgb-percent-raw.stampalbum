# Functional RGB Percentage Syntax Showcase (AlbumEasy Raw Mode)
ALBUM_PAGES_SIZE (215.9 279.4)
ALBUM_PAGES_MARGINS (15.0 15.0 15.0 15.0)
ALBUM_PAGES_SPACING (4.0 10.0)
ALBUM_PAGES_BORDER (0.5 0.1 0.0 1.25)
COLOUR_ALBUM_BORDER ("rgb(12%, 29%, 48%)")
ALBUM_PAGES_TITLE (TB 15 "FUNCTIONAL RGB PERCENTAGE COLORS: rgb(R%, G%, B%)" 3)
COLOUR_STAMP_BORDER ("rgb(13%, 55%, 13%)")
COLOUR_STAMP_TEXT ("rgb(10%, 10%, 10%)")
STAMP_BOXES_SIZE_ADJUST (2.0)

PAGE_START
PAGE_TEXT_CENTRE (HN 9 "Demonstrating rgb(r%, g%, b%) percentage palette (rgb(12%,29%,48%) border, rgb(13%,55%,13%) stamps)")
PAGE_VSPACE (6.0)
ROW_ALIGN_MIDDLE
ROW_START_FS (HN 8 0.25 4.0)
STAMP_ADD_IMG (35.0 26.0 "../spacing-v1/images/san-marino.jpg" "" "" "San Marino")
STAMP_ADD_IMG (36.0 22.0 "../spacing-v1/images/new-zealand.jpg" "" "" "New Zealand")
