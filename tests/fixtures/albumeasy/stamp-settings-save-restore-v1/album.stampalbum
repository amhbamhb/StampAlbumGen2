# Native save/restore proof: mutable image/outline/background state.
# Global frame/caption styling remains fixed; see README for comparison gaps.
STAMPALBUM 1
ALBUM_PAGES_SIZE (215.9 279.4)
ALBUM_PAGES_MARGINS (15 15 15 15)
ALBUM_PAGES_SPACING (4 14)
ALBUM_PAGES_BORDER (0.2 0 0 0)
COLOUR_ALBUM_BORDER (black)
NATIVE_PAGE_TITLE (TB 16 "UNITED STATES - LIBERTY ISSUE" 5)
NATIVE_PAGE_HEADER (HN 9 C "1959-1960  |  STAMP SETTINGS SAVE AND RESTORE" 0 0)
NATIVE_PAGE_FOOTER_NUMBER (HN 9 C 1 "Page " " of $PAGES$" 0 0 darkblue)
NATIVE_ROW_ALIGNMENT (center)
NATIVE_STAMP_FRAME (0.1 darkblue 6)
NATIVE_STAMP_TEXT_POLICY (wrap_to_frame percent 100 0 0 1.5)
NATIVE_STAMP_IMAGE_POLICY (millimetres 0 0 false preserve grayscale show)
NATIVE_STAMP_BACKGROUND (lightblue)
NATIVE_STAMP_OUTLINE (show)

STAMP_IMAGE ("../stamp-pagination-v1/us-150.png" 52 29 0.05078125 "HN" 8 "DB 150 / SG 1125a\n52 x 29 mm\nBaseline / greyscale")
STAMP_IMAGE ("../stamp-pagination-v1/us-152.png" 26 29 0.052 "HN" 8 "DB 152 / SG 1137b\n26 x 29 mm\nBaseline / greyscale")
NATIVE_STAMP_SETTINGS_SAVE ()
NATIVE_ROW_BREAK ()
NATIVE_STAMP_IMAGE_POLICY (percent 15 15 false fit colour show)
NATIVE_STAMP_BACKGROUND (white)
STAMP_IMAGE ("../stamp-pagination-v1/us-150.png" 52 29 0.05078125 "HN" 8 "Same DB 150 image\nTemporary native fit\nPercentage padding / colour")
STAMP_IMAGE ("../stamp-pagination-v1/us-152.png" 26 29 0.052 "HN" 8 "Same DB 152 image\nTemporary native fit\nPercentage padding / colour")
NATIVE_STAMP_SETTINGS_RESTORE ()
NATIVE_ROW_BREAK ()
STAMP_IMAGE ("../stamp-pagination-v1/us-150.png" 52 29 0.05078125 "HN" 8 "DB 150 / SG 1125a\n52 x 29 mm\nRestored / greyscale")
STAMP_IMAGE ("../stamp-pagination-v1/us-152.png" 26 29 0.052 "HN" 8 "DB 152 / SG 1137b\n26 x 29 mm\nRestored / greyscale")
NATIVE_ROW_BREAK ()

NATIVE_STAMP_IMAGE_POLICY (millimetres 0 0 false preserve grayscale hide)
NATIVE_STAMP_OUTLINE (hide)
STAMP_IMAGE ("../stamp-pagination-v1/us-156.png" 52 29 0.0506822612 "HN" 8 "DB 156 / SG 1148a\n52 x 29 mm\nSaved hidden image")
STAMP_IMAGE ("../stamp-pagination-v1/us-151.png" 26 29 0.0534979424 "HN" 8 "DB 151 / SG 1137a\n26 x 29 mm\nSaved hidden image")
NATIVE_STAMP_SETTINGS_SAVE ()
NATIVE_ROW_BREAK ()
NATIVE_STAMP_IMAGE_POLICY (millimetres 0 0 false preserve colour show)
NATIVE_STAMP_OUTLINE (show)
NATIVE_STAMP_BACKGROUND (white)
STAMP_IMAGE ("../stamp-pagination-v1/us-156.png" 52 29 0.0506822612 "HN" 8 "Same DB 156 image\nTemporary shown image\nColour / white background")
STAMP_IMAGE ("../stamp-pagination-v1/us-151.png" 26 29 0.0534979424 "HN" 8 "Same DB 151 image\nTemporary shown image\nColour / white background")
NATIVE_STAMP_SETTINGS_RESTORE ()
NATIVE_ROW_BREAK ()
STAMP_IMAGE ("../stamp-pagination-v1/us-156.png" 52 29 0.0506822612 "HN" 8 "DB 156 / SG 1148a\n52 x 29 mm\nRestored hidden image")
STAMP_IMAGE ("../stamp-pagination-v1/us-151.png" 26 29 0.0534979424 "HN" 8 "DB 151 / SG 1137a\n26 x 29 mm\nRestored hidden image")
