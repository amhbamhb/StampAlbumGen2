STAMP_ADD_IMG (32 35 "../stamp-pagination-v1/us-152.png" "" "DB 152 / SG 1137b\n26 x 29 mm\nBlack persists" "")

PAGE_TEXT_CENTRE (HN 9 "COLOUR ALIAS  |  NO FRAME  |  BLANK BORDER" 5)
ROW_START_ES (HN 8 0.1)
COLOUR_STAMP_BACKGROUND (lightblue)
STAMP_ADD_IMG (32 35 "../stamp-pagination-v1/us-151.png" "" "DB 151 / SG 1137a\n26 x 29 mm\nLightblue / framed" "")
STAMP_ADD_IMG (32 35 "../stamp-pagination-v1/us-152.png" "" "DB 152 / SG 1137b\n26 x 29 mm\nLightblue / NO_FRAME" "" NO_FRAME)
STAMP_BORDER_STYLE (BLANK)
STAMP_ADD_IMG (32 35 "../stamp-pagination-v1/us-151.png" "" "DB 151 / SG 1137a\n26 x 29 mm\nLightblue / BLANK" "")

PAGE_TEXT_CENTRE (HN 9 "HIDDEN IMAGE  |  RESET TO WHITE" 5)
ROW_START_ES (HN 8 0.1)
STAMP_BORDER_STYLE (SOLID)
COLOR_STAMP_BACKGROUND (black)
ALBUM_STAMP_IMG_HIDE
STAMP_ADD_IMG (32 35 "../stamp-pagination-v1/us-152.png" "" "DB 152 / SG 1137b\n26 x 29 mm\nHidden image / black" "")
ALBUM_STAMP_IMG_SHOW
COLOUR_STAMP_BACKGROUND (white)
STAMP_ADD_IMG (58 35 "../stamp-pagination-v1/us-156.png" "" "DB 156 / SG 1148a\n52 x 29 mm\nWhite reset / shown" "")
