    rect rgb(200, 220, 255)
        Note over User,SQLite: Phase 1: Bootstrap (Country Selection)
        User->>BrowserJS: Navigates to localhost:PORT
        BrowserJS->>+BootstrapSrv: GET /
        BootstrapSrv->>BootstrapSrv: render_bootstrap_html()
        BootstrapSrv-->>-BrowserJS: HTML + country list
        BrowserJS->>User: Displays country picker
    end

    rect rgb(220, 240, 200)
        Note over User,SQLite: Phase 2: User selects country
        User->>BrowserJS: Clicks country "Switzerland"
        BrowserJS->>+BootstrapSrv: POST /select-country<br/>{country, db_path}
        BootstrapSrv->>BootstrapSrv: load_config_with_override()
        BootstrapSrv->>ConfigFile: Read album config
        BootstrapSrv->>ReviewSrv: State transition<br/>(launch_state=Selected)
        BootstrapSrv-->>-BrowserJS: {ok: true, redirect}
        BrowserJS->>User: Redirects to /
    end

    rect rgb(240, 220, 200)
        Note over User,SQLite: Phase 3: Review UI loads
        BrowserJS->>+ReviewSrv: GET / (new state)
        ReviewSrv->>+DB: init_db()
        DB->>SQLite: Check schema, migrate if needed
        SQLite-->>-DB: Schema OK
        ReviewSrv->>+DB: sync_processed_colnect_candidates()
        DB->>SQLite: Load colnect_stamps table
        SQLite-->>-DB: Return candidates
        ReviewSrv->>+Matcher: build_matcher_payload()<br/>(load_left_stamps, load_right)
        Matcher->>SQLite: Query left (base) stamps
        Matcher->>SQLite: Query right (candidates)
        Matcher-->>-ReviewSrv: {left[], right[]}
        ReviewSrv->>ReviewSrv: render_html(payload)
        ReviewSrv-->>-BrowserJS: Compare UI HTML + JS payload
        BrowserJS->>User: Displays left/right panels
    end

    rect rgb(255, 240, 200)
        Note over User,SQLite: Phase 4: User navigates & assigns
        User->>BrowserJS: Searches left stamp, browses right candidates
        BrowserJS->>BrowserJS: Client-side search & filter (no server calls)
        User->>BrowserJS: Clicks "Assign Candidate"
        BrowserJS->>BrowserJS: Local state update<br/>(assignedByLeft[rowid]=colnect_id)
        BrowserJS->>User: Shows "Staged" indicator
    end

    rect rgb(255, 200, 200)
        Note over User,SQLite: Phase 5: Apply matches to DB
        User->>BrowserJS: Clicks "Apply Matches To DB"
        BrowserJS->>+ReviewSrv: POST /apply-matches<br/>{matches: [{left_rowid, colnect_id}]}
        ReviewSrv->>+DB: apply_matches()
        DB->>SQLite: UPDATE base_stamps SET colnect_id=?
        DB->>SQLite: UPDATE fields per user filters
        SQLite-->>DB: Rows updated
        DB-->>-ReviewSrv: {updated: N, skipped: M}
        ReviewSrv->>ReviewSrv: Update local state
        ReviewSrv-->>-BrowserJS: {ok: true, message}
        BrowserJS->>User: Shows "Applied" status
    end

    rect rgb(240, 200, 255)
        Note over User,SQLite: Phase 6: Save config & close
        User->>BrowserJS: Changes PDF sort order
        BrowserJS->>+ReviewSrv: POST /api/config-editor-save<br/>{default_sort_mode: "catalog"}
        ReviewSrv->>ConfigFile: Write updated config.toml
        ConfigFile-->>ReviewSrv: File saved
        ReviewSrv-->>-BrowserJS: {ok: true}
        User->>BrowserJS: Clicks "Close Review UI"
        BrowserJS->>+ReviewSrv: POST /shutdown<br/>{generate_album, generate_pdf}
        ReviewSrv->>ReviewSrv: Optional: run album generator
        ReviewSrv-->>-BrowserJS: {ok: true, output_path}
        BrowserJS->>User: Shows output path, closes window
