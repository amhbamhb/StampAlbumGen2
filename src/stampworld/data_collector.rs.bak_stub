use log::{debug, info};
use crate::types::ImageStatus;

// Minimal, well-formed collector stub that compiles and preserves the public API.
// This allows the project to build so we can iteratively reintroduce the hardened
// StampWorld scraping logic without duplicate definitions causing E0428 errors.

pub fn collect_stampworld_data(
    _sequencer: &mut i32,
    _separator: &str,
    _site_name: &str,
    _images_directory: &str,
    _month_number: &dyn Fn(&str) -> String,
    _get_stampworld_image: &dyn Fn(&str, bool) -> ImageStatus,
    _base_url: &str,
    _start_year: i32,
    _end_year: i32,
    _overwrite_images: bool,
    _page_callback: Option<&dyn Fn(usize)>,
    _max_pages: i32,
    _stop_after_no_hits: i32,
) -> Vec<String> {
    debug!("Stub collect_stampworld_data called for site: {}", _site_name);
    info!("StampWorld collector stub in use; no remote scraping performed.");
    // Return empty vector (no stamps collected) so callers can continue.
    Vec::new()
}
